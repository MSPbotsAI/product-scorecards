# Copy to .env.local (gitignored) and fill in. Nothing here is a secret.

# How the backend reads the scorecard datasets.
#
# Set this and the app reads them with its own credential — required whenever the app is NOT served
# from the platform origin (local dev), because there is no user session to borrow there: the
# browser's app.mspbots.ai session is unreadable from localhost, production's login app exposes no
# route that hands a token to an external origin, and an agentint token cannot read production data.
#
# Generate one at https://app.mspbots.ai/PublicApi → "Add New Key". Paste it here yourself; it is a
# credential, so it belongs only in this file.
#
# Leave it unset and the app falls back to token mode, forwarding the caller's own platform token —
# which is the right mode once the app is installed and served under /apps/product-scorecards/.
PUBLIC_API_KEY=

# Override only to point at a different environment. Defaults shown.
# PUBLIC_API_HOST=https://api.mspbots.ai/
# MSPBOTS_REPORT_HOST=https://app.mspbots.ai/web/reports
