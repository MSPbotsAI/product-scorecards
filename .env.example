# Copy to .env.local (gitignored) and fill in the blanks. Real env always wins over these files.
# Cascade (dotenvx): .env.[mode].local > .env.[mode] > .env.local > .env
# Never set the injected metadata by hand (BASE_URL / APP_ID / APP_NAME / APP_VERSION).

# ── Database (mb-database skill) ──
# Local development: the shared MSPBots dev database — disposable, holds no sensitive data.
# Every local app uses it with the common `mb_dev` role; each app lives in its own Postgres schema (= package.json id),
# which the migration creates itself. Nothing to fill in — the shared dev credentials below are intentionally committed.
DB_TYPE=postgresql
DB_HOST=20.241.40.252
DB_PORT=15432
DB_NAME=mb_app_agentint
DB_USER=mb_dev
DB_PASSWORD=p5KUtRvT_2c4IEEtW

# Deployed apps: per-tenant access goes through pg-proxy (tenant-mgr). Injected by the platform — leave unset locally.
# DB_PROXY_BASE_URL=<tenant-mgr app root, e.g. http://mb-app-pg-tenant-mgr:8080/apps/mb-app-pg-tenant-mgr>
# DB_PROXY_API_KEY=<X-API-Key for pg-proxy>
# Pool tuning (optional, defaults shown): DB_POOL_MAX=2 DB_IDLE_TIMEOUT=120 DB_EVICT_TTL=600 DB_MAX_POOLS=100

# ── Auth (mb-auth skill) ──
# Local dev: no auth service runs. ENV=dev makes an empty token resolve to a superAdmin mock user.
# NEVER set ENV=dev in a deployed environment — it bypasses JWT verification.
ENV=dev
# Deployed: Logto SSO. Injected by the platform (App Publish registers the app's OIDC client) — leave unset locally.
# AUTH_PROVIDER=logto
# LOGTO_ISSUER=<https://<platform-host>/oidc>
# LOGTO_APP_ID=<this app's Logto SPA client id>
# LOGTO_AUDIENCE=<usually the same as LOGTO_APP_ID>
# LOGTO_ADMIN_ROLES=admin,superAdmin

# ── Redis (required by @mspbots/auth for tenant API keys and the per-tenant install gate) ──
# REDIS_HOST=
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0

# ── Platform ──
# Gateway base other apps are reached through (e.g. https://<platform-host>); injected in deployed environments.
# PLATFORM_URL=
# HMAC key for public link tokens (signPublicToken / parsePublicToken in @mspbots/tenant-db — mb-database skill §5b).
# Only needed by apps that expose public links; injected in deployed environments (Dokploy project shared variable).
# Local: any non-empty value — tokens minted locally are only valid locally.
PUBLIC_TOKEN_SECRET=local-dev-only

# ── This app: how the backend reads the scorecard datasets ──
# Set this and the app reads them with its own credential ("public mode"). Required for local dev: the
# platform token you get locally is not accepted by the app.mspbots.ai reports API. The key can also be
# saved from the Settings page (stored per tenant in the app database, which wins over this env).
#
# Generate one at https://app.mspbots.ai/PublicApi → "Add New Key". It is a credential — .env.local only.
#
# Leave it unset and the app falls back to "token mode", forwarding the caller's own platform token
# together with the tenant id from that token.
PUBLIC_API_KEY=

# Override only to point at a different environment. Defaults shown.
# PUBLIC_API_HOST=https://api.mspbots.ai/
# MSPBOTS_REPORT_HOST=https://app.mspbots.ai/web/reports
